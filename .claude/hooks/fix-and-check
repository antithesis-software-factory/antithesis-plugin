#!/usr/bin/env bash
# Claude Code Stop hook: apply automatic fixes, then run every check.
#
# A failing check blocks the stop (exit 2) and hands the output to Claude to fix. If
# Claude is already continuing because of this hook, the failure goes to the user
# instead, so an unfixable failure can't loop forever.
set -uo pipefail

input=$(cat)
cd "${CLAUDE_PROJECT_DIR:-.}" || exit 0
export NO_COLOR=1

# Show the user a message, as Stop hook JSON. Escapes by hand, so jq isn't needed.
system_message() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/}
  s=${s//$'\n'/\\n}
  printf '{"systemMessage": "%s"}\n' "$s"
}

# A hash of every file git sees, tracked or untracked but not ignored, by path and
# content. When it matches the last tree that passed, fix and check would change and
# find nothing, so skip them. git does the hashing, so no other tool is needed.
fingerprint() {
  local files
  files=$(git ls-files -z --cached --others --exclude-standard -- . ':!.claude/worktrees' 2> /dev/null |
    while IFS= read -r -d '' f; do [ -f "$f" ] && printf '%s\n' "$f"; done) || return
  [ -n "$files" ] || return
  { printf '%s\n' "$files"; git hash-object --stdin-paths <<< "$files"; } | git hash-object --stdin
}
current=$(fingerprint)
stamp=$(git rev-parse --git-path fix-and-check-passed 2> /dev/null)
if [ -n "$current" ] && [ -n "$stamp" ] && [ "$(cat "$stamp" 2> /dev/null)" = "$current" ]; then
  exit 0
fi

if ! command -v mise > /dev/null; then
  system_message "Skipped this repo's checks: mise isn't installed. See AGENTS.md."
  exit 0
fi
# An untrusted mise.toml is the user's call to approve, not Claude's.
if ! error=$(mise tasks ls 2>&1 > /dev/null); then
  error=$(grep -vE 'Version:|MISE_VERBOSE' <<< "$error")
  system_message "Skipped this repo's checks: mise can't load mise.toml here.
${error}
If it isn't trusted, run \`mise trust\` in $PWD. To trust every worktree too, add the repo to mise's trusted_config_paths setting."
  exit 0
fi

# Checks that need the network skip themselves, so the network can't fail a turn. CI runs them.
export CHECK_OFFLINE=1
mise run --quiet fix > /dev/null 2>&1
if output=$(mise run --quiet check 2>&1); then
  current=$(fingerprint)
  if [ -n "$current" ] && [ -n "$stamp" ]; then printf '%s\n' "$current" > "$stamp"; fi
  exit 0
fi

# Rerun just the failed checks, so their output isn't buried under the passing ones.
task='check:[A-Za-z0-9_-]+'
failed=$(grep -oE "\[$task\] exited with status" <<< "$output" | grep -oE "$task" | sort -u)
report=$(
  for t in $failed; do
    echo
    echo "## mise run $t"
    mise run --quiet "$t" 2>&1 | grep -vE "^\[$task\] \\$ " | tail -n 40
  done
  [ -n "$failed" ] || tail -n 40 <<< "$output"
)

if grep -qE '"stop_hook_active"[[:space:]]*:[[:space:]]*true' <<< "$input"; then
  system_message "\`mise run check\` still fails after Claude's attempt to fix it:
$report"
  exit 0
fi

echo "\`mise run check\` failed after \`mise run fix\`. Fix these, then run \`mise run check\` again.$report" >&2
exit 2
