#!/usr/bin/env bash
# Claude Code Stop hook: apply automatic fixes, then run every check.
#
# A failing check blocks the stop (exit 2) and hands the output to Claude to fix. If
# Claude is already continuing because of this hook, the failure goes to the user
# instead, so an unfixable failure can't loop forever.
set -uo pipefail

input=$(cat)
cd "${CLAUDE_PROJECT_DIR:-.}" || exit 0
command -v mise > /dev/null || exit 0
# An untrusted mise.toml is the user's call to approve, not Claude's.
mise tasks ls > /dev/null 2>&1 || exit 0

# A hash of every file git sees, tracked or untracked but not ignored. When it matches
# the last tree that passed, fix and check would change and find nothing, so skip them.
fingerprint() {
  git ls-files -z --cached --others --exclude-standard -- . ':!.claude/worktrees' 2> /dev/null |
    xargs -0 sha1sum 2> /dev/null | sha1sum | cut -d' ' -f1
}
stamp=$(git rev-parse --git-path fix-and-check-passed 2> /dev/null)
if [ -n "$stamp" ] && [ "$(cat "$stamp" 2> /dev/null)" = "$(fingerprint)" ]; then
  exit 0
fi

# Link checks stay local, so the network can't fail a turn. CI checks external links.
export CHECK_OFFLINE=1
mise run --quiet fix > /dev/null 2>&1
if output=$(mise run --quiet check 2>&1); then
  [ -n "$stamp" ] && fingerprint > "$stamp"
  exit 0
fi

# Rerun just the failed checks, so their output isn't buried under the passing ones.
task='check:[A-Za-z0-9_-]+'
failed=$(grep -oE "\[$task\] exited with status" <<< "$output" | grep -oE "$task" | sort -u)
report=$(
  for t in $failed; do
    echo
    echo "## mise run $t"
    mise run --quiet "$t" 2>&1 | grep -vE "^\[$task\] \\$ " | tail -n 40
  done
  [ -n "$failed" ] || tail -n 40 <<< "$output"
)

if grep -qE '"stop_hook_active"[[:space:]]*:[[:space:]]*true' <<< "$input"; then
  message="\`mise run check\` still fails after Claude's attempt to fix it:
$report"
  jq -n --arg m "$message" '{systemMessage: $m}' 2> /dev/null ||
    printf '{"systemMessage": "mise run check still fails. Run it to see why."}\n'
  exit 0
fi

echo "\`mise run check\` failed after \`mise run fix\`. Fix these, then run \`mise run check\` again.$report" >&2
exit 2
