#!/usr/bin/env python3
"""Check the file references inside every skill.

Skills name their bundled files as paths from the skill root, usually in backticks
(`references/triage/MODULE.md`) and sometimes as Markdown links. For each skill this
fails when a referenced file doesn't exist, or when a bundled file can't be reached
from SKILL.md by following references, at any depth.

    scripts/check-references
"""
import os
import sys
from pathlib import Path

from skills import BUNDLED_DIRS, ROOT, references, skills

ANNOTATE = bool(os.environ.get("GITHUB_ACTIONS"))


def report(path: Path, line: int, message: str) -> None:
    rel = path.relative_to(ROOT)
    if ANNOTATE:
        print(f"::error file={rel},line={line},title=check-references::{message}")
    else:
        print(f"{rel}:{line}: {message}")


def check(skill_md: Path) -> int:
    skill = skill_md.parent
    internal = skill.relative_to(ROOT).parts[0] == ".agents"
    bundled = {
        p.relative_to(skill).as_posix()
        for d in BUNDLED_DIRS
        for p in (skill / d).rglob("*")
        if p.is_file()
    }
    problems = 0
    reached, queue = set(), [skill_md]
    while queue:
        source = queue.pop()
        if source in reached:
            continue
        reached.add(source)
        if source.suffix != ".md":
            continue
        for line, target in sorted(set(references(source.read_text()))):
            path = skill / target
            if path.is_file():
                queue.append(path)
            # A repo-internal skill may name the repo's own files, such as `scripts/set-version`.
            # A shipped skill may not: its install has only what the skill bundles.
            elif not path.is_dir() and not (internal and (ROOT / target).exists()):
                report(source, line, f"`{target}` does not exist in skill `{skill.name}`")
                problems += 1
    for rel in sorted(bundled - {p.relative_to(skill).as_posix() for p in reached}):
        report(skill / rel, 1, f"`{rel}` is not reachable from {skill.name}/SKILL.md")
        problems += 1
    return problems


def main() -> int:
    found = skills()
    problems = sum(check(s) for s in found)
    if not problems:
        print(f"{len(found)} skills: every reference resolves and every file is reachable")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
